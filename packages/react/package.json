{
  "name": "@adminui/react",
  "version": "8.3.0",
  "description": "React 19 component library for data-dense admin backends: page templates, data tables, a multi-view grid, access management, dashboards, forms, themes and AI-ready usage rules.",
  "keywords": [
    "react",
    "admin",
    "admin-dashboard",
    "backoffice",
    "components",
    "ui",
    "design-system",
    "data-table",
    "data-grid",
    "dashboard",
    "radix",
    "shadcn",
    "typescript"
  ],
  "homepage": "https://adminui.zygskins.cn",
  "bugs": {
    "url": "https://github.com/xx2468171796/admin-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xx2468171796/admin-ui.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "admin-ui contributors",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "admin-ui-audit": "scripts/ui-audit.mjs",
    "admin-ui": "scripts/ui-audit.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#aui-css/core.css": {
      "types": "./src/styles.css.d.ts",
      "node": "./src/styles/none.js",
      "default": "./src/styles.css"
    },
    "#aui-css/*": {
      "types": "./src/styles.css.d.ts",
      "node": "./src/styles/none.js",
      "default": "./src/styles/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./styles.css": {
      "types": "./src/styles.css.d.ts",
      "default": "./src/styles.css"
    },
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "source": "./src/charts.tsx",
      "default": "./dist/src/charts.js"
    },
    "./markdown": {
      "types": "./dist/src/markdown.d.ts",
      "source": "./src/markdown.tsx",
      "default": "./dist/src/markdown.js"
    },
    "./catalog": {
      "types": "./dist/src/catalog.d.ts",
      "source": "./src/catalog.ts",
      "default": "./dist/src/catalog.js"
    },
    "./excel": {
      "types": "./dist/src/excel.d.ts",
      "source": "./src/excel.ts",
      "default": "./dist/src/excel.js"
    },
    "./grid": {
      "types": "./dist/src/grid.d.ts",
      "source": "./src/grid.tsx",
      "default": "./dist/src/grid.js"
    },
    "./access": {
      "types": "./dist/src/access/index.d.ts",
      "source": "./src/access/index.ts",
      "default": "./dist/src/access/index.js"
    },
    "./peizhi": {
      "types": "./dist/src/peizhi/index.d.ts",
      "source": "./src/peizhi/index.ts",
      "default": "./dist/src/peizhi/index.js"
    },
    "./settings": {
      "types": "./dist/src/peizhi/index.d.ts",
      "source": "./src/peizhi/index.ts",
      "default": "./dist/src/peizhi/index.js"
    },
    "./record-detail-spec": {
      "types": "./dist/src/record-detail-spec.d.ts",
      "source": "./src/record-detail-spec.ts",
      "default": "./dist/src/record-detail-spec.js"
    },
    "./grid-query": {
      "types": "./dist/src/grid-query.d.ts",
      "source": "./src/grid-query.ts",
      "default": "./dist/src/grid-query.js"
    },
    "./views": {
      "types": "./dist/src/views/index.d.ts",
      "source": "./src/views/index.ts",
      "default": "./dist/src/views/index.js"
    },
    "./form-builder": {
      "types": "./dist/src/form-builder/index.d.ts",
      "source": "./src/form-builder/index.ts",
      "default": "./dist/src/form-builder/index.js"
    },
    "./forms-public": {
      "types": "./dist/src/form-builder/public.d.ts",
      "source": "./src/form-builder/public.ts",
      "default": "./dist/src/form-builder/public.js"
    },
    "./dashboard-builder": {
      "types": "./dist/src/dashboard-builder.d.ts",
      "source": "./src/dashboard-builder.tsx",
      "default": "./dist/src/dashboard-builder.js"
    },
    "./org-picker": {
      "types": "./dist/src/org-picker/index.d.ts",
      "source": "./src/org-picker/index.ts",
      "default": "./dist/src/org-picker/index.js"
    }
  },
  "files": [
    "src",
    "scripts/ui-audit.mjs",
    "scripts/ui-audit.d.mts",
    "examples/starter/index.html",
    "examples/starter/package.json",
    "examples/starter/tsconfig.json",
