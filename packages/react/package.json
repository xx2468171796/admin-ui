    "test:media": "node test/media.mjs",
    "test:history": "node test/history.mjs",
    "test:ai": "node test/ai.mjs",
    "test:records": "node test/records.mjs",
    "test:share": "node test/share.mjs",
    "test:org-picker": "node test/org-picker.mjs",
    "test:views": "node test/views.mjs",
    "test:form-builder": "node test/form-builder.mjs",
    "test:transcript": "node test/transcript.mjs",
    "test:dashboard-builder": "node test/dashboard-builder.mjs",
    "test:date-picker": "node test/date-picker.mjs",
    "test:access-modules": "node test/access-modules.mjs",
    "build": "node ../../scripts/build-dist.mjs .",
    "test:form-controls": "node test/form-controls.mjs",
    "test:basics": "node test/basics.mjs",
    "test:overlays": "node test/overlays.mjs",
    "test:notification-center": "node test/notification-center.mjs",
    "test:command-palette": "node test/command-palette.mjs",
    "test:charts": "node test/charts.mjs",
    "test:inputs": "node test/inputs.mjs",
    "test:inputs-numbers": "node test/inputs-numbers.mjs",
    "test:inputs-uploads": "node test/inputs-uploads.mjs",
    "test:inputs-condition": "node test/inputs-condition.mjs",
    "test:navigation": "node test/navigation.mjs",
    "test:collab": "node test/collab.mjs",
    "size": "node scripts/size-budget.mjs",
    "css:check": "node scripts/css-chunks.mjs",
    "audit:examples": "node scripts/ui-audit.mjs examples/starter/src examples/small/src examples/large/src",
    "guard": "node ../../scripts/check-internal.mjs ../.. --quiet"
  },
  "dependencies": {
