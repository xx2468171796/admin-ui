    "examples/single-service/gitignore.example",
    "examples/single-service/prepare.mjs",
    "examples/single-service/web/package.json",
    "examples/single-service/web/tsconfig.json",
    "examples/single-service/web/vite.config.ts",
    "examples/single-service/web/index.html",
    "examples/single-service/web/src",
    "examples/single-service/go/main.go",
    "examples/single-service/go/go.mod",
    "examples/single-service/go/go.sum",
    "examples/single-service/rust/Cargo.toml",
    "examples/single-service/rust/Cargo.lock",
    "examples/single-service/rust/src/main.rs",
    "examples/governance",
    "skills/admin-ui/SKILL.md",
    "README.md",
    "INTEGRATION.md",
    "AI-RULES.md",
    "DESIGN.md",
    "TABLES.md",
    "ACCESS.md",
    "WORKFLOWS.md",
    "GRID.md",
    "DASHBOARDS.md",
    "PAGE-TEMPLATES.md",
    "VIEWS.md",
    "MIGRATION-8.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "THIRD-PARTY.md",
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.consumer.json",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run audit:access && node scripts/css-chunks.mjs && node ../../scripts/check-dist.mjs . && npm run size && npm run guard",
    "audit:starter": "node scripts/ui-audit.mjs examples/starter/src",
    "audit:access": "node scripts/ui-audit.mjs src/access src/peizhi",
    "test:browser": "node test/browser.mjs",
    "test:packed": "node test/packed.mjs",
    "prepare:single-service": "node examples/single-service/prepare.mjs",
    "test:single-service": "node test/single-service.mjs",
    "test:motion": "node test/motion.mjs",
    "test:workflows": "node test/workflows.mjs",
    "test:design": "node test/design.mjs",
    "test:business-tables": "node test/business-tables.mjs",
    "test:governance": "node test/governance.mjs",
    "test:dashboards-kit": "node test/dashboards-kit.mjs",
    "test:components": "node test/components.mjs",
    "test:grid": "node test/grid.mjs",
    "test:access": "node test/access.mjs",
    "test:access-governance": "node test/access-governance.mjs",
    "test:grid-edit": "node test/grid-edit.mjs",
    "test:grid-panels": "node test/grid-panels.mjs",
    "test:grid-tools": "node test/grid-tools.mjs",
    "test:record-detail": "node test/record-detail.mjs",
